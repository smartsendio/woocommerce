<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Docs/bootstrap.php"
         colors="true" failOnWarning="true">
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="SS_DOCS_ENABLED" value="1"/>
    </php>
    <testsuites>
        <testsuite name="Docs"><directory>tests/Docs</directory></testsuite>
    </testsuites>
</phpunit>
