{
  "name": "smartsend/woocommerce",
  "description": "Smart Send plugin for WooCommerce",
  "minimum-stability": "stable",
  "license": "proprietary",
  "authors": [
    {
      "name": "Smart Send",
      "email": "support@smartsend.io"
    }
  ],
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "digitalrevolution/php-codesniffer-baseline": "^1.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-browser": "^4.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "process-timeout": 900,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "digitalrevolution/php-codesniffer-baseline": true,
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "setup": "bin/setup-local-dev.sh",
    "phpcs": "phpcs",
    "phpcs:compat": "phpcs --standard=phpcs.compat.xml.dist",
    "phpcs:fix": "phpcbf",
    "test": "bin/run-tests.sh Integration,Browser",
    "test:integration": "bin/run-tests.sh Integration",
    "test:browser": "bin/run-tests.sh Browser",
    "test:docs": "bin/run-tests.sh Docs",
    "demo:on": "bin/demo-store.sh on",
    "demo:off": "bin/demo-store.sh off",
    "demo:scenario": "bin/demo-store.sh scenario"
  }
}
