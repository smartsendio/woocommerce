# Example env file for the local development store (bin/setup-local-dev.sh,
# bin/demo-store.sh). Copy to .env and adjust; the test suites use
# .env.testing instead (created automatically by bin/run-tests.sh with
# CI-matching defaults). Both files are git-ignored - this example is the
# version-controlled reference. Resolution order for every knob:
# explicit --flag > exported environment variable > env file entry > default.

# Where the store lives on disk. Resolved relative to the repository root.
WP_PATH=../../playground/smart-send-woocommerce

# The store's URL. Point it at a Laravel Herd parked/linked directory (plain
# http://, not `herd secure`) and no manual web server is needed; a
# localhost URL means bin/run-tests.sh manages a PHP built-in server itself.
WP_URL=http://smart-send-woocommerce.test

# Checkout page type: "block" (the WooCommerce Checkout block) or "classic"
# (the [woocommerce_checkout] shortcode). Default: block.
WP_CHECKOUT=block

# WooCommerce "Prices entered with tax": "include" or "exclude".
# Default: include. Dev stores are seeded with a 25% Danish VAT rate so the
# setting takes effect.
WP_PRICES_TAX=include
