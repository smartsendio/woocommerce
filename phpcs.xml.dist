<?xml version="1.0"?>
<ruleset name="Smart Send WooCommerce">
    <description>WordPress coding standards for the Smart Send WooCommerce plugin.</description>

    <file>smart-send-logistics</file>

    <!-- Generated build output (wp-scripts; includes machine-written *.asset.php). -->
    <exclude-pattern>smart-send-logistics/build/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/local-dev/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <!-- Report paths relative to the repository root. -->
    <arg name="basepath" value="."/>

    <!-- Show progress, sniff codes, and use colors; check up to 20 files in parallel. -->
    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="parallel" value="20"/>
    <arg name="extensions" value="php"/>

    <!-- Minimum supported WordPress version for WPCS sniffs. -->
    <config name="minimum_wp_version" value="6.5"/>

    <rule ref="WordPress">
        <!-- Allow short array syntax and modern PHP conventions. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- Documentation-only sniffs are aspirational for the legacy codebase. -->
        <exclude name="Squiz.Commenting"/>
        <exclude name="Generic.Commenting"/>
    </rule>

    <!-- First-party classes share one namespace; these globals are retained APIs. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="Smart_Send"/>
                <element value="SS_SHIPPING"/>
                <element value="SS_Shipping"/>
            </property>
        </properties>
    </rule>

    <!-- WooCommerce's order capability, checked by the fulfillment REST controller. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_shop_orders"/>
                <element value="edit_shop_order"/>
                <element value="edit_others_shop_orders"/>
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="smart-send-logistics"/>
            </property>
        </properties>
    </rule>
</ruleset>
